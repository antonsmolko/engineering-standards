{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$"
        }
      },
      "required": ["name", "version", "namespace"]
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "range": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["name", "range"]
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*-[A-Z0-9]+-[0-9]{3}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "enum": ["required", "recommended"]
          },
          "status": {
            "enum": ["proposed", "accepted", "deprecated"]
          },
          "document": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "enum": ["automatic", "manual", "combined"]
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "refines": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "replaces": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "conflicts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "title",
          "level",
          "status",
          "document",
          "verification",
          "requires",
          "refines",
          "replaces",
          "conflicts"
        ]
      }
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(?:core|(?:domains|technologies)/[a-z][a-z0-9]*(?:-[a-z0-9]+)*|stacks/[a-z][a-z0-9]*(?:-[a-z0-9]+)*/[a-z][a-z0-9]*(?:-[a-z0-9]+)*)$(?![\\s\\S])"
          },
          "kind": {
            "enum": ["core", "domain", "technology", "stack"]
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(?:core|(?:domains|technologies)/[a-z][a-z0-9]*(?:-[a-z0-9]+)*|stacks/[a-z][a-z0-9]*(?:-[a-z0-9]+)*/[a-z][a-z0-9]*(?:-[a-z0-9]+)*)$(?![\\s\\S])"
            },
            "uniqueItems": true
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": ["id", "kind", "requires", "requirements"]
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "document": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id", "requirements", "document"]
      }
    },
    "implementations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "module": {
            "type": "string",
            "minLength": 1
          },
          "requiresProfiles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "requiresModules": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "document": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "module",
          "requiresProfiles",
          "requiresModules",
          "requirements",
          "document"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "package",
    "requires",
    "requirements",
    "profiles",
    "modules",
    "implementations"
  ]
}
